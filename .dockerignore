# Anything not needed to build or run. Two reasons this matters more than image size:
#
# 1. `.env` holds live provider keys. A COPY that swept it into the image would bake secrets
#    into a layer, where they survive being deleted in a later step and travel with the image.
# 2. A stale local `web/dist` or `node_modules` copied in would shadow what the build stage
#    produces, and the deployed app would silently be an old build.

.env
.env.*
!.env.example
*.key
*.pem

.git
.gitignore
.github
.claude

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

node_modules/
web/node_modules/
web/dist/

*.db
*.sqlite
*.sqlite3
data/uploads/

# Development-only material. Tests, evaluation and experiments do not run in the container, and
# the docs are read on GitHub.
tests/
eval/
experiments/
scripts/
docs/
*.md
!README.md

.vscode/
.idea/
.DS_Store
Thumbs.db
