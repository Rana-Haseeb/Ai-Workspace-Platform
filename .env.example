# Copy to .env and fill in. NEVER commit the real .env.
# Run `python scripts/probe_providers.py` after filling this in — it reports which keys and
# model ids actually work, without printing any key.

# ---- Active LLM provider ----
# One of: groq | groq2 | groq3 | google | openrouter | xai | openai
LLM_PROVIDER=groq
# Optional: force a specific model id (else the provider default from core/config.py is used).
# LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Cross-provider fallback: if the active provider fails (rate limit, outage, bad model id),
# try these next, in order. Unconfigured names are filtered out automatically, so listing
# them all is free. Set to "" to disable failover and fail fast.
LLM_FALLBACK_PROVIDERS=groq2,groq3,google,openrouter

# ---- Provider keys (only the ones you have) ----
GROQ_API_KEY=
# Optional second/third key on DIFFERENT accounts. Groq meters tokens per organisation,
# not per key, so another org is a genuine second allowance.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# ---- Database ----
# Local development and the whole test suite run on SQLite — no network, no setup.
# Production sets this to the Supabase SESSION POOLER string (IPv4-compatible); the direct
# db.<ref>.supabase.co host is IPv6-only and will not resolve on most hosts.
# URL-encode special characters in the password (e.g. '@' -> %40).
DATABASE_URL=sqlite:///./workspace.db

# ---- Authentication ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every issued login token is invalidated if this changes.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Embeddings and chunking (knowledge base) ----
EMBEDDING_PROVIDER=google          # google | openai | none
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                  # gemini-embedding-001 is natively 3072;
                                   # 768 is a supported truncation and 4x smaller
CHUNK_SIZE=800                     # characters per chunk
CHUNK_OVERLAP=120                  # characters shared between neighbouring chunks
RETRIEVAL_MODE=hybrid              # bm25 | vector | hybrid
RETRIEVAL_TOP_K=6

# ---- Long-term memory ----
MEMORY_ENABLED=true
MEMORY_MAX_ITEMS_IN_CONTEXT=8      # hard cap on memories injected into a prompt
MEMORY_MIN_IMPORTANCE=0.3

# ---- API ----
# Comma-separated origins allowed to call the API. The Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=30
API_HOST=127.0.0.1
API_PORT=8000

# ---- Frontend build ----
# Where the React app looks for the API. Left empty in production, because uvicorn serves
# the built SPA from the same origin.
VITE_API_URL=http://127.0.0.1:8000
